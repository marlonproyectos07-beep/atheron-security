# URL pública del sitio, usada para metadata absoluta, JSON-LD y sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp Business de Atheron Security, en formato internacional
# sin signos (ej. 573001234567).
# REQUIERE_FUENTE: número real confirmado por el equipo comercial.
# Sin este valor, el CTA de WhatsApp se muestra deshabilitado
# ("WhatsApp (próximamente)") en todo el sitio — nunca navega a un número
# de relleno.
NEXT_PUBLIC_ATHERON_WHATSAPP_NUMBER=

# Gate de indexación (auditoría 001B). Por defecto (sin definir, o
# cualquier valor distinto de "true") el sitio entero se sirve con
# noindex,nofollow y robots.txt en disallow total: un piloto sin dominio
# definitivo no debe quedar indexable por accidente. Poner en "true" SOLO
# cuando el CEO apruebe la publicación pública real.
NEXT_PUBLIC_ALLOW_INDEXING=false
